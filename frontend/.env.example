# URL dasar API backend (tanpa trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# Realtime WebSocket (Laravel Reverb)
# Aktifkan (true) bila server Nginx sudah dikonfigurasi proxy_pass /app ke port 8080
VITE_ENABLE_REVERB=false
VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
