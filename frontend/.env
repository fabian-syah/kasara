VITE_API_BASE_URL=https://api.stokps.com/api

# Realtime WebSocket (Laravel Reverb)
# Aktifkan jika server Nginx api.stokps.com sudah dikonfigurasi proxy_pass /app ke port 8080
VITE_ENABLE_REVERB=false
VITE_REVERB_APP_KEY=apexkey
VITE_REVERB_HOST=api.stokps.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https